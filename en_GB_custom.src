escape_char /
comment_char %

LC_IDENTIFICATION
title      "GB English with ISO Date/Time/Address and US Number/Currency"
source     "en_GB_custom"
address    "N/A"
contact    "Andreas Toth"
email      "andreas.toth@xtra.co.nz"
tel        ""
fax        ""
language   "English"
territory  "United Kingdom"
revision   "1.0"
date       "2025-06-19"
END LC_IDENTIFICATION

LC_CTYPE
copy "en_GB"
END LC_CTYPE

LC_COLLATE
copy "en_GB"
END LC_COLLATE

LC_MONETARY
int_curr_symbol           "USD "
currency_symbol           "$"
mon_decimal_point         "."
mon_thousands_sep         ","
mon_grouping              3;3
positive_sign             ""
negative_sign             "-"
int_frac_digits           2
frac_digits               2
p_cs_precedes             1
p_sep_by_space            0
n_cs_precedes             1
n_sep_by_space            0
p_sign_posn               1
n_sign_posn               1
