# Target locale combination, shared by the apply, restore and test scripts.
#
# British English everywhere, except:
#   - time:        ISO 8601 (en_SE is the stock English locale with ISO dates in
#                  both glibc and Qt/CLDR)
#   - money:       USD (developer locale: matches the en_US default of most tooling)
#   - measurement: metric (Qt/CLDR treats en_GB as imperial; en_SE is metric
#                  in both glibc and Qt)
#
# Numbers need no override: en_GB already uses "." decimal and "," grouping.

LOCALE_LANG="en_GB.UTF-8"
LOCALE_TIME="en_SE.UTF-8"
LOCALE_MONETARY="en_US.UTF-8"
LOCALE_MEASUREMENT="en_SE.UTF-8"
